{
  "name": "@lotuswebagency/sitemap-inspector-core",
  "version": "0.1.0",
  "description": "Streaming XML sitemap engine: fetch, tokenize, parse and validate sitemaps and robots.txt with bounded memory. No DOM, no browser APIs.",
  "keywords": [
    "sitemap",
    "sitemap.xml",
    "sitemap-index",
    "xml",
    "robots.txt",
    "seo",
    "validator",
    "parser",
    "streaming",
    "gzip",
    "hreflang"
  ],
  "author": "LW AGENCY LIMITED",
  "license": "MIT",
  "homepage": "https://github.com/LotusWebAgency/sitemap-inspector-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LotusWebAgency/sitemap-inspector-core.git"
  },
  "bugs": {
    "url": "https://github.com/LotusWebAgency/sitemap-inspector-core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./discovery": { "types": "./dist/discovery.d.ts", "import": "./dist/discovery.js", "default": "./dist/discovery.js" },
    "./extensions": { "types": "./dist/extensions.d.ts", "import": "./dist/extensions.js", "default": "./dist/extensions.js" },
    "./fetcher": { "types": "./dist/fetcher.d.ts", "import": "./dist/fetcher.js", "default": "./dist/fetcher.js" },
    "./hash53": { "types": "./dist/hash53.d.ts", "import": "./dist/hash53.js", "default": "./dist/hash53.js" },
    "./lang-codes": { "types": "./dist/lang-codes.d.ts", "import": "./dist/lang-codes.js", "default": "./dist/lang-codes.js" },
    "./normalize": { "types": "./dist/normalize.d.ts", "import": "./dist/normalize.js", "default": "./dist/normalize.js" },
    "./parser": { "types": "./dist/parser.d.ts", "import": "./dist/parser.js", "default": "./dist/parser.js" },
    "./printer": { "types": "./dist/printer.d.ts", "import": "./dist/printer.js", "default": "./dist/printer.js" },
    "./robots": { "types": "./dist/robots.d.ts", "import": "./dist/robots.js", "default": "./dist/robots.js" },
    "./row-flags": { "types": "./dist/row-flags.d.ts", "import": "./dist/row-flags.js", "default": "./dist/row-flags.js" },
    "./sitemap-limits": { "types": "./dist/sitemap-limits.d.ts", "import": "./dist/sitemap-limits.js", "default": "./dist/sitemap-limits.js" },
    "./tokenizer": { "types": "./dist/tokenizer.d.ts", "import": "./dist/tokenizer.js", "default": "./dist/tokenizer.js" },
    "./types": { "types": "./dist/types.d.ts", "import": "./dist/types.js", "default": "./dist/types.js" },
    "./url": { "types": "./dist/url.d.ts", "import": "./dist/url.js", "default": "./dist/url.js" },
    "./validator": { "types": "./dist/validator.d.ts", "import": "./dist/validator.js", "default": "./dist/validator.js" },
    "./w3c-date": { "types": "./dist/w3c-date.d.ts", "import": "./dist/w3c-date.js", "default": "./dist/w3c-date.js" }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
