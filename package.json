{
  "name": "@lotuswebagency/sitemap-inspector-core",
  "version": "0.1.0",
  "description": "Streaming XML sitemap engine: fetch, tokenize, parse and validate sitemaps and robots.txt with bounded memory. No DOM, no browser APIs.",
  "keywords": [
    "sitemap",
    "sitemap.xml",
    "sitemap-index",
    "xml",
    "robots.txt",
    "seo",
    "validator",
    "parser",
    "streaming",
    "gzip",
    "hreflang"
  ],
  "author": "LW AGENCY LIMITED",
  "license": "MIT",
  "homepage": "https://github.com/LotusWebAgency/sitemap-inspector-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LotusWebAgency/sitemap-inspector-core.git"
  },
  "bugs": {
    "url": "https://github.com/LotusWebAgency/sitemap-inspector-core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
